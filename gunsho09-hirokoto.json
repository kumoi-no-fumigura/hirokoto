 "poems": [
  {
   "seq": "1",
   "text": "けふそとはよのまに誰かつけつらんあくれは軈て春めきに鳬",
   "kana": "",
   "speaker": "惟宗廣言集",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "子日とも思はてすくる春の野に松に引れてたちとまりぬる",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "見わたせはあしたの原のうす霞うすきや春のはしめ成らん",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "漣やなからのやまに雪きえて志賀の渡りはかすみこめたり",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "春かすみたなひきぬれは浪こゆと音にやきかむすゑの松山",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "あふ坂のせきゆく人ば誰ならん霞のうちに聲のきこゆる",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "もしほやく煙になるゝあま人は霞に春をわかすや有らん",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "春くとはまかきの梅に見えぬるをわれつけかほに鶯のなく",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "我宿のまかきの梅をねくらにてよをこめてなく鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "宿ちかき谷のふるすは雪きえてまたうちとけぬ鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "おく山の谷のふしきのこけむしろ春さへ雪そ際しさにけり",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "人はいさわれとはふまじ若菜つむそともの野への雪のむら消",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "春くれはおとろかしたにもえいてゝおりしる物は蕨なりけり",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "花かとてたつねきたれは白雲のたつたの山の梢なりけり",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "我こゝろなくさめよとや山櫻たつぬる峯にかゝるふら雲",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "よし野山かすみはれゆく絕まより立かはりぬる花のしら雲",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "朝またき春の木すゑを見渡せはかすみにきゆる花のしら雪",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "花ゆへにみ雪ふりにしわたりをは思ひやいつるしら川の水",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "難波瀉つらねてかへる雁金はおなしもしなるあして成けり",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "いかなれは春を重ねてみつれとも八重にのみさく山吹の花",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "夏ころも人めはかりはかふれとも花になれにしとをしそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "九重にけふわかきつる夏ころも猶うすきなやたゝむとすらん",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "下枝まておりゐる鷺とみゆる哉ゆるきのもりにさける卯花",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "尋ねかねふる山路にほとゝきす一こゑなくやなさけ成らん",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "一こゑをきゝての後も時鳥またなくことはかはらさりけり",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "聲よりや姿や人に忍ふらんくるれは名のるほとゝきす哉",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "郭公あかてすきぬる一聲に思はぬかたへ駒をはやむる",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "小夜ふけて一こゑなのる郭公きかすやあらんいねのあま人",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "五月雨にそことも見えぬ難波江は芦の末葉そみをつくしなる",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "つく〓〓と軒の玉水をとつれていくかに成ぬ五月雨の空",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "五月雨に旅寐の床のうきぬれはいかたにやみる心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "ともしするすそのゝ原のかり衣この下露にぬれぬ夜そなき",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "秋ならは稻はの露にぬれなましさなへをわくろ小田の細道",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "鵜舟をはかゝりもしらすいてにけり螢飛かふまきのしま人",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "吹風に芦の葉そよく夕暮はあさちに虫のなかぬはかりそ",
   "kana": "",
   "speaker": "惟宗廣言集",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "荒れはてゝとふ人もなき宿なれと庭のあさちに秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "かさゝきのはしよりわたる七夕はこよひの雨や急かさるらむ",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "夕霧のうちわたりぬる小萩原にしきをたゝむ心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "露しけき野路の篠原わけゆけは袖ぬらさするをみなへし哉",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "鶉なくいはたのをのゝ女郞花おらてすくへき心地こそせね",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "さらぬたに露のこほるゝ荻の葉に風わたるなり秋のゆふ暮",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "とふにいとゝ思ひかれゝよ鶉なく伏見の里の秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "天の原いまはいとはし秋の月のこゝろにいるも苦しかりけり",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "見渡せはおほえの山に雲はれていくのともなくすめる月かな",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "月〓み志賀のからさき見渡せは氷をあらふおきつ白なみ",
   "kana": "",
   "speaker": "",
   "page": 442,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "名にたてるゑしまか崎を見わたせは空行月をうつす成けり",
   "kana": "",
   "speaker": "惟宗廣言集",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "雲をいてゝくもにまたいる月影やふれは消ぬる庭のしら雪",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "月の舟秋のなかはをこきすきてなに流るゝはこよひ成けり",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "思ひきや妻よふ鹿の聲ゆへにさもあらぬ袖をぬらすへしとは",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "何方と聲わかねとも身にしむは鹿の音おろす木からしの風",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "淋しさを何にたとへむを鹿なくみやまの里の明かたの空",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "露しけき淺茅か原に鳴むしはよその袖をもぬらす也けり",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "ませのうちにまたきふりつむ白雪の移ふにこそ菊としりぬれ",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "朝またきけさ立いてゝもみち葉をよるの錦となるまてそみる",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "うつり行都のかたをしたひてや秋も今夜は西へくれぬる",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "いつしかとそともの小田に風さえてもりこし水もうす氷けり",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "磯ちかくもみちを拂ふたつ田姫またいくしほか染むとすらん",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "しくるとて柞か下にたちよれはふれとぬらさぬこのは成けり",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "さらぬたに朝たつ袖は露けきに時雨てわたるのちのしのはら",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "日をへつゝなみの花さく網代木に紅葉をさへもよせてける哉",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "冬かれの淺茅かすゑにをく露のきゆる雫ほたるひ也けり",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "今朝よりは松の葉しろく雪消てさひしさ增るみやまへの里",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "雪ふかみ駒はこゆれとあふ坂の關の岩かとふみもならさす",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "降つもる雪ふみ分てくる人は心さしさへ深きなりけり",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "つらゝゐるまのゝ入江にこく舟の跡としめつゝかつくにほ鳥",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "すはの海の月のこほりにゐる鴨はさえぬおりにや思ひとく覽",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "やよやいかにかたふく月を眺れはふけゐの浦に千とり鳴也",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "千鳥なく浮寐のとこのとまやかたとまらぬ物はなみた成けり",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "埋火のなからましかは小筵にひとりや冬のよをあかさまし",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "數ならぬ身には積らぬ年ならはけふの暮をもなけかさらまし",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "思ひあまりかきもらしつる水莖に戀わたるとはけふやしる覽",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "よとゝもにつゝむ袖しのうら波は心にかけめときのまそなき",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "ちらさしと袖に泪をつゝむまに戀をかれしといふに成ぬる",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "あふ事は心なかくそ賴まれぬたれも命をしらぬよなれは",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "しるらむや谷のいはまのうもれ水もらすに袖のぬれ增るとは",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "かけそめてまたねもなれぬ琴の〓をいかなる人のひきたかふ覽",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "我戀はたゝみつふするかたし貝みなあふ事のなきそかなしき",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "思ひかね駒にまかせていてぬれはこひちの末はあふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "月影のはれゆくまゝにいかなれは涙の雨のふり增るらん",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "思ひきやおいその杜に身はなりてあはぬ歎の積るへしとは",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "なをさりの契はわれに年をへてねたしや誰にあふの松原",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "あふ事をそふとてけふものひぬれはあすもあすとやいはむとす覽",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "片身とて袖にしめつるうつりかを洗ふはけさのなみた成けり",
   "kana": "",
   "speaker": "惟宗廣言集",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "あはてこそ恨もせしか葛の葉のかへるけさまた露のこほるゝ",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "恨むるも我ならひにて賴まるゝ戀しき〓とのあるかと思へは",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "きぬ〓〓にならむ歎といひなしてあらぬ淚を君にかけつる",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "はかなくそ後のよ迄と契りけるまたきにたにもかはる心を",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "逢ふ〓との露はかりみなかれぬれはこれや歎きのもりの下草",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "まことにやそりはてにける梓弓おもひかへらん事もこそあれ",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "引すへてわかて馴れにしはし鷹のそりにし〓ををいつか忘れん",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "君が代はなかゐのうらのさゝれ石の松おひしける山となる迄",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "心から玉藻のくつとかゝれにき何かゑしまの恨みしもせん",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "まゆすみも姿もあらす成ゆくをいかにかはらぬ涙なるらむ",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "かくしつゝつひの住家と思ふにも野への旅ねは露そこほるゝ",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "黑髮のみたれてものゝかなしきはおもふ筋にもなき世んけり",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "かくはかり數ならぬ身のいかなれは人よりさきに物は悲しき",
   "kana": "",
   "speaker": "",
   "page": 443,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "世中を思ひみたるゝたひ〓とに昔をのみそ忍ふもちすり",
   "kana": "",
   "speaker": "鴨長明集",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "露の身の仇なる〓とをふれとてやためしにひけるさゝかにの糸",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "この身にて光をさゝむさゝとしも心ひとつに有明の月",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "やはらくる塵はかりこそかはるらめ神も佛もおなし身なれは",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
